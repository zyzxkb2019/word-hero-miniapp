page {
  background: #1b102f;
}

.splash-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

.splash-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.overlay {
  position: relative;
  z-index: 2;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: linear-gradient(180deg, rgba(10, 5, 20, 0.10) 0%, rgba(10, 5, 20, 0.22) 48%, rgba(10, 5, 20, 0.78) 100%);
}

.top-spacer {
  height: 980rpx;
}

.bottom-panel {
  margin: 0 32rpx 44rpx;
  padding: 28rpx 28rpx 34rpx;
  border-radius: 28rpx;
  background: rgba(12, 10, 24, 0.45);
  border: 2rpx solid rgba(255, 210, 115, 0.22);
  backdrop-filter: blur(12rpx);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.28);
}

.welcome {
  color: #fff6df;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.4;
}

.desc {
  margin-top: 12rpx;
  color: rgba(255, 246, 223, 0.82);
  font-size: 26rpx;
  line-height: 1.6;
}

.enter-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  height: 92rpx;
  line-height: 1;
  padding: 0;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ffcf52 0%, #ff8f1f 100%);
  color: #6b2300;
  font-size: 32rpx;
  font-weight: 800;
  box-shadow: 0 16rpx 40rpx rgba(255, 123, 0, 0.35);
}
.enter-btn::after {
  border: 0;
}
.parent-btn {
  margin-top: 18rpx;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #fff6df;
  border: 2rpx solid rgba(255, 255, 255, 0.24);
  font-size: 28rpx;
  font-weight: 800;
}
