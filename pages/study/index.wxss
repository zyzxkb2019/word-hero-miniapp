.quiz-card {
  background: linear-gradient(135deg, #eef2ff 0%, #fff7ed 100%);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.08);
  border: 2rpx solid rgba(79, 70, 229, 0.10);
}

.quiz-label {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(79, 70, 229, 0.12);
  color: #4338ca;
  font-size: 24rpx;
  font-weight: 800;
}

.quiz-meaning {
  margin-top: 28rpx;
  font-size: 54rpx;
  line-height: 1.25;
  font-weight: 900;
  color: #111827;
}

.quiz-tip {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #64748b;
}

.answer-reveal {
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #15803d;
  font-size: 30rpx;
  font-weight: 800;
}

.choice-btn {
  width: 100%;
  text-align: left;
  border-radius: 22rpx;
  background: #f8fafc;
  color: #111827;
  margin-bottom: 18rpx;
  font-weight: 700;
}

.spelling-prompt {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 22rpx;
}

.feedback {
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: #ecfdf5;
  color: #15803d;
  font-size: 28rpx;
  line-height: 1.6;
  margin: 24rpx 0;
}

.feedback.wrong {
  background: #fff7ed;
  color: #c2410c;
}

/* 答对金币爆闪与连击特效 */
.coin-burst {
  position: fixed;
  left: 0;
  right: 0;
  top: 220rpx;
  height: 520rpx;
  z-index: 999;
  pointer-events: none;
  overflow: visible;
}

.coin {
  position: absolute;
  left: 50%;
  top: 48%;
  font-size: 46rpx;
  opacity: 0;
  transform: translate(-50%, -50%) scale(0.5);
  animation: coinFly 980ms ease-out forwards;
  text-shadow: 0 8rpx 20rpx rgba(255, 143, 31, 0.45);
}

.coin-1 { animation-delay: 0ms; }
.coin-2 { animation-delay: 40ms; }
.coin-3 { animation-delay: 80ms; }
.coin-4 { animation-delay: 120ms; }
.coin-5 { animation-delay: 160ms; }
.coin-6 { animation-delay: 200ms; }
.coin-7 { animation-delay: 240ms; }
.coin-8 { animation-delay: 280ms; }

.coin-1 { --x: -245rpx; --y: -170rpx; }
.coin-2 { --x: -120rpx; --y: -235rpx; }
.coin-3 { --x: 20rpx; --y: -260rpx; }
.coin-4 { --x: 190rpx; --y: -185rpx; }
.coin-5 { --x: 250rpx; --y: -25rpx; }
.coin-6 { --x: 130rpx; --y: 130rpx; }
.coin-7 { --x: -80rpx; --y: 155rpx; }
.coin-8 { --x: -235rpx; --y: 45rpx; }

@keyframes coinFly {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.45) rotate(0deg);
  }
  18% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.18) rotate(12deg);
  }
  100% {
    opacity: 0;
    transform: translate(calc(-50% + var(--x)), calc(-50% + var(--y))) scale(0.75) rotate(360deg);
  }
}

.combo-pop {
  position: fixed;
  left: 50%;
  top: 250rpx;
  width: 620rpx;
  transform: translateX(-50%);
  z-index: 1000;
  padding: 30rpx 28rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #fff7ad 0%, #ffb02e 42%, #ff5d2a 100%);
  box-shadow: 0 24rpx 70rpx rgba(255, 107, 0, 0.46);
  border: 4rpx solid rgba(255, 255, 255, 0.72);
  text-align: center;
  pointer-events: none;
  animation: comboPop 1100ms cubic-bezier(0.18, 0.89, 0.32, 1.28) forwards;
}

.combo-main {
  color: #7c2100;
  font-size: 48rpx;
  line-height: 1.25;
  font-weight: 1000;
  text-shadow: 0 4rpx 0 rgba(255, 255, 255, 0.45);
}

.combo-sub {
  margin-top: 10rpx;
  color: rgba(124, 33, 0, 0.78);
  font-size: 24rpx;
  font-weight: 800;
}

@keyframes comboPop {
  0% {
    opacity: 0;
    transform: translateX(-50%) translateY(40rpx) scale(0.58) rotate(-4deg);
  }
  18% {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1.12) rotate(2deg);
  }
  55% {
    opacity: 1;
    transform: translateX(-50%) translateY(-8rpx) scale(1) rotate(0deg);
  }
  100% {
    opacity: 0;
    transform: translateX(-50%) translateY(-70rpx) scale(0.92);
  }
}

.study-green-box {
