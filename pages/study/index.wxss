}
.study-spelling-title {
  color: #1d4ed8;
  font-size: 26rpx;
  font-weight: 900;
  margin-bottom: 14rpx;
}
.study-spelling-chip {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #2563eb;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
}
.word-memory-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 0 0 14rpx;
}
.memory-pill,
.memory-detail {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 800;
}
.memory-pill {
  background: #fef3c7;
  color: #92400e;
}
.memory-detail {
  background: #f1f5f9;
  color: #475569;
}
.memory-detail.spelling {
  background: #dbeafe;
  color: #1d4ed8;
}
.review-hint {
  margin-bottom: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #fff7ed;
  color: #9a3412;
  font-size: 25rpx;
  line-height: 1.5;
}

.phonetic-line {
  margin-bottom: 20rpx;
  font-size: 25rpx;
  color: #6366f1;
  font-weight: 800;
}
.context-card {
  margin-bottom: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%);
  border: 2rpx solid rgba(99, 102, 241, 0.12);
}
.cloze-card {
  background: linear-gradient(135deg, #fff7ed 0%, #eef2ff 100%);
  border-color: rgba(249, 115, 22, 0.18);
}
.context-label {
  color: #4f46e5;
  font-size: 22rpx;
  font-weight: 900;
  margin-bottom: 10rpx;
}
.context-sentence {
  color: #111827;
  font-size: 30rpx;
  line-height: 1.55;
  font-weight: 800;
}
.context-source {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
}
.wrong-shake {
  background: #fee2e2 !important;
  color: #991b1b !important;
  animation: wrongShake 420ms ease-in-out;
}
@keyframes wrongShake {
  0%, 100% { transform: translateX(0); }
  18% { transform: translateX(-16rpx); }
  36% { transform: translateX(14rpx); }
  54% { transform: translateX(-10rpx); }
  72% { transform: translateX(8rpx); }
}

/* v0.1.15 听音辨义 */
.listening-card {
  background: linear-gradient(135deg, #ecfeff 0%, #f5f3ff 52%, #fff7ed 100%);
  border-color: rgba(14, 165, 233, 0.18);
}

.speaker-zone {
  margin-top: 28rpx;
  padding: 34rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.75);
  border: 2rpx solid rgba(79, 70, 229, 0.10);
  text-align: center;
}

.speaker-button {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  margin: 0 auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 35% 28%, rgba(255,255,255,0.92) 0, rgba(255,255,255,0.22) 24%, transparent 25%),
    linear-gradient(135deg, #111827 0%, #2563eb 58%, #06b6d4 100%);
  box-shadow: 0 18rpx 42rpx rgba(37, 99, 235, 0.30);
  animation: speakerPulse 1600ms ease-in-out infinite;
}
.speaker-icon {
  position: relative;
  width: 72rpx;
  height: 62rpx;
}
.speaker-core {
  position: absolute;
  left: 4rpx;
  top: 18rpx;
  width: 22rpx;
  height: 26rpx;
  background: #ffffff;
  border-radius: 6rpx;
}
.speaker-core::after {
  content: '';
  position: absolute;
  left: 18rpx;
  top: -12rpx;
  width: 0;
  height: 0;
  border-top: 25rpx solid transparent;
  border-bottom: 25rpx solid transparent;
  border-right: 28rpx solid #ffffff;
}
.speaker-wave {
  position: absolute;
  top: 50%;
  border: 5rpx solid #ffffff;
  border-left: 0;
  border-top-color: transparent;
  border-bottom-color: transparent;
  transform: translateY(-50%);
  opacity: 0.95;
}
.wave-one {
  left: 44rpx;
  width: 18rpx;
  height: 34rpx;
  border-radius: 0 34rpx 34rpx 0;
}
.wave-two {
  left: 54rpx;
  width: 28rpx;
  height: 50rpx;
  border-radius: 0 50rpx 50rpx 0;
  opacity: 0.7;
}

.speaker-title {
  color: #111827;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 900;
}

.speaker-tip {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.5;
}

.meaning-choice {
  text-align: left;
  line-height: 1.45;
  min-height: 92rpx;
  white-space: normal;
}

.replay-btn {
  margin-top: 8rpx;
}

@keyframes speakerPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}

.theme-dark .listening-card {
  background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 52%, #164e63 100%) !important;
  border-color: rgba(125, 211, 252, 0.18) !important;
}

.theme-dark .speaker-zone {
  background: rgba(15, 23, 42, 0.78) !important;
  border-color: rgba(148, 163, 184, 0.22) !important;
}

.theme-dark .speaker-title {
  color: #f8fafc !important;
}

.theme-dark .speaker-tip {
  color: #cbd5e1 !important;
}

/* v0.1.16 强化听音辨义入口 */
.version-pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 224, 138, 0.22);
  color: #8b5a00;
  font-size: 22rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}
.quick-mode-row {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
}
.quick-mode {
  flex: 0 0 auto;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.62);
  color: #75522a;
  font-size: 24rpx;
  font-weight: 700;
  border: 2rpx solid rgba(255,255,255,0.72);
}
.quick-mode.active {
  background: linear-gradient(135deg, #ffb703, #fb8500);
  color: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(251, 133, 0, 0.26);
}
.listening-tag {
  min-width: 160rpx;
  text-align: center;
}
.theme-dark .version-pill {
  background: rgba(255, 199, 95, 0.18);
  color: #ffd166;
}
.theme-dark .quick-mode {
  background: rgba(255,255,255,0.08);
  color: #e8d7b9;
  border-color: rgba(255,255,255,0.12);
}
.theme-dark .quick-mode.active {
  background: linear-gradient(135deg, #f59e0b, #f97316);
  color: #fff7ed;
}
