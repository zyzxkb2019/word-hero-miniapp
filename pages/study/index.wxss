}
.study-green-chip {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #16a34a;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
}

.memory-dashboard {
  margin-bottom: 18rpx;
}

.study-spelling-box {
  margin-bottom: 24rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #dbeafe 0%, #eff6ff 100%);
