.home-page { padding-bottom: 48rpx; }
.home-hero { background: linear-gradient(135deg, #312e81 0%, #4f46e5 48%, #06b6d4 100%); color: #fff; }
.home-hero .page-title { color: #fff; }
.home-hero .page-subtitle { color: rgba(255,255,255,0.82); }
.hero-topline { font-size: 22rpx; letter-spacing: 3rpx; color: rgba(255,255,255,0.7); font-weight: 900; margin-bottom: 16rpx; }
.parent-code { display: inline-flex; margin-top: 20rpx; padding: 12rpx 18rpx; border-radius: 999rpx; background: rgba(255,255,255,0.16); color: #fff; font-size: 24rpx; font-weight: 900; }
.current-panel { margin-bottom: 28rpx; padding: 30rpx; border-radius: 30rpx; background: #fff; box-shadow: 0 10rpx 30rpx rgba(15,23,42,0.06); display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.panel-kicker { color:#4f46e5; font-size:22rpx; font-weight:900; letter-spacing:2rpx; margin-bottom:8rpx; }
.word-list-title { font-size: 34rpx; font-weight: 900; color: #111827; margin-bottom: 10rpx; }
.start-btn { width: 180rpx; min-width: 180rpx; height: 82rpx; line-height: 82rpx; border-radius: 999rpx; background: linear-gradient(135deg,#f97316,#facc15); color: #7c2d12; font-size: 26rpx; font-weight: 1000; }
.section-label { margin: 34rpx 4rpx 18rpx; color:#0f172a; font-size:30rpx; font-weight:1000; }
.module-grid { display:grid; grid-template-columns:1fr 1fr; gap:18rpx; }
.wordbank-grid .module-card.main { grid-column: span 2; min-height: 190rpx; background: linear-gradient(135deg,#fff7ed,#ffedd5); }
.module-card { min-height: 170rpx; padding: 26rpx; border-radius: 30rpx; background:#fff; box-shadow: 0 10rpx 30rpx rgba(15,23,42,0.06); }
.module-icon { font-size: 44rpx; margin-bottom: 16rpx; }
.module-title { font-size: 30rpx; font-weight: 1000; color:#111827; }
.module-desc { margin-top: 8rpx; color:#64748b; font-size:24rpx; line-height:1.5; }
.feature-card { display:flex; align-items:center; justify-content:space-between; gap:22rpx; padding:34rpx; border-radius:34rpx; margin-bottom:22rpx; color:#fff; box-shadow: 0 14rpx 38rpx rgba(15,23,42,0.12); }
.feature-card.story { background: linear-gradient(135deg,#7c3aed,#ec4899); }
.feature-card.report { background: linear-gradient(135deg,#0f766e,#14b8a6); }
.feature-title { font-size: 34rpx; font-weight: 1000; line-height:1.35; }
.feature-desc { margin-top: 12rpx; color: rgba(255,255,255,0.84); font-size:25rpx; line-height:1.6; }
.feature-arrow { width: 64rpx; height:64rpx; line-height:64rpx; text-align:center; border-radius:50%; background: rgba(255,255,255,0.18); font-size:40rpx; font-weight:900; }

.review-task-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fef3c7 0%, #ffedd5 100%);
  border: 2rpx solid rgba(245, 158, 11, 0.18);
}
.resume-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #dbeafe 0%, #eef2ff 100%);
  border: 2rpx solid rgba(79, 70, 229, 0.18);
}
.task-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #111827;
}
.task-desc {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.6;
}
.feature-card.community {
  background: linear-gradient(135deg, #ecfeff 0%, #f5f3ff 100%);
  border: 2rpx solid rgba(8, 145, 178, 0.14);
}
.theme-dark .review-task-card,
.theme-dark .resume-card,
.theme-dark .feature-card.community {
  background: #1e293b !important;
}
