.import-hero {
  background: linear-gradient(135deg, #ede9fe 0%, #ffffff 54%, #ecfeff 100%);
}
.limit-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  background: #0f172a;
  color: #fff;
}
.limit-num {
  font-size: 44rpx;
  font-weight: 1000;
  color: #facc15;
}
.limit-card .muted {
  color: rgba(255,255,255,0.7);
  font-size: 22rpx;
}
.limit-right {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255,255,255,0.82);
}
.mode-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-bottom: 28rpx;
}
.mode-tab {
  border-radius: 22rpx;
  padding: 20rpx 10rpx;
  text-align: center;
  background: #f1f5f9;
  color: #475569;
  font-size: 26rpx;
  font-weight: 900;
}
.mode-tab.active {
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  color: #fff;
  box-shadow: 0 12rpx 26rpx rgba(79,70,229,0.18);
}
.word-row {
  display: grid;
  grid-template-columns: 240rpx 1fr;
  gap: 18rpx;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}
.word-row.needs-check {
  background: #fff7ed;
  margin: 0 -12rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
  border-radius: 18rpx;
}
.word {
  font-size: 30rpx;
  font-weight: 900;
  color: #111827;
}
.meaning-input {
  min-height: 72rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  padding: 16rpx 18rpx;
  font-size: 27rpx;
  color: #334155;
}
.word-edit-stack {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.example-input {
  min-height: 116rpx;
  border-radius: 18rpx;
  background: #fff7ed;
  padding: 16rpx 18rpx;
  font-size: 25rpx;
  line-height: 1.45;
  color: #92400e;
}
.error-row {
  font-size: 26rpx;
  color: #f97316;
  line-height: 1.7;
}
.helper,
.progress-text {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
}
.mini-btn {
  margin-top: 16rpx;
  width: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #3730a3;
  background: #e0e7ff;
}
.secondary-btn.warm {
  background: #ffedd5;
  color: #9a3412;
}
.ocr-preview {
  display: block;
  width: 100%;
  height: 280rpx;
  border-radius: 24rpx;
  margin-top: 18rpx;
  background: #f1f5f9;
}
.ocr-preview-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}
.ocr-preview-list .ocr-preview {
  width: 100%;
  height: 180rpx;
  margin-top: 0;
}
.textarea.small {
  min-height: 180rpx;
  margin-top: 18rpx;
}
.check-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #c2410c;
}
.check-tip.error {
  color: #dc2626;
}
.fix-btn {
  display: inline-flex;
  margin: 8rpx 0 0;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #fed7aa;
  color: #9a3412;
  font-size: 22rpx;
}

.preview-phonetic { color:#6366f1; font-size:22rpx; font-weight:800; margin-top:4rpx; }
