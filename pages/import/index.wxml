<view class="container {{themeClass}}">
  <view class="hero-card import-hero">
    <view class="page-title">创建专属生词库</view>
    <view class="page-subtitle">支持手动输入、图片识别、教材单元、错题本导入。每次最多 50 个词/短语，每个学生最多 {{wordListLimit}} 个词库。</view>
  </view>

  <view class="card limit-card">
    <view class="limit-left">
      <view class="limit-num">{{listCount}} / {{wordListLimit}}</view>
      <view class="muted">当前已建词库 / 上限</view>
    </view>
    <view class="limit-right">建议按日期、单元、错题专题分开建库，方便家长看进度。</view>
  </view>

  <view class="card">
    <view class="mode-tabs">
      <view class="mode-tab {{inputMode === 'manual' ? 'active' : ''}}" data-mode="manual" bindtap="chooseMode">手动输入</view>
      <view class="mode-tab {{inputMode === 'image' ? 'active' : ''}}" data-mode="image" bindtap="chooseMode">图片识别</view>
      <view class="mode-tab {{inputMode === 'textbook' ? 'active' : ''}}" data-mode="textbook" bindtap="chooseMode">教材单元</view>
      <view class="mode-tab {{inputMode === 'mistakes' ? 'active' : ''}}" data-mode="mistakes" bindtap="chooseMode">错题本</view>
    </view>

    <view class="form-item">
      <text class="label">词库名称</text>
      <input class="input" placeholder="比如 6月5日生词库 / 校内Unit 4" value="{{title}}" bindinput="onTitleInput" />
      <button class="mini-btn" bindtap="useDateTitle">用今天日期命名</button>
    </view>

    <block wx:if="{{inputMode === 'manual'}}">
      <view class="form-item">
        <text class="label">粘贴英文单词 / 短语</text>
        <textarea class="textarea" placeholder="例如：parrot、thanks to、come from。短语请单独一行或用逗号隔开" value="{{rawText}}" bindinput="onTextInput" />
        <view class="helper">只填英文，不用手动输入中文；系统会在预览区提醒疑似拼写错误。</view>
      </view>
    </block>

    <block wx:if="{{inputMode === 'image'}}">
      <view class="form-item">
        <text class="label">拍照 / 选择图片</text>
        <button class="secondary-btn" bindtap="chooseImage">选择/拍照图片（最多3张）</button>
        <view wx:if="{{imagePaths.length}}" class="ocr-preview-list">
          <image wx:for="{{imagePaths}}" wx:key="*this" class="ocr-preview" src="{{item}}" mode="aspectFill" />
        </view>
        <image wx:elif="{{imagePath}}" class="ocr-preview" src="{{imagePath}}" mode="aspectFill" />
        <button class="secondary-btn warm" loading="{{ocrBusy}}" bindtap="recognizeImage">识别图片文字</button>
        <textarea class="textarea small" placeholder="图片识别出的英文会出现在这里，也可以手动粘贴修正" value="{{ocrText}}" bindinput="onOcrTextInput" />
        <button class="secondary-btn" bindtap="useOcrText">使用这段文字</button>
        <view class="helper">图片识别依赖微信 OCR 能力。若个别图片识别不准，可在这里手动改一下再保存。</view>
      </view>
    </block>

    <block wx:if="{{inputMode === 'textbook'}}">
      <view class="form-item">
        <text class="label">从教材单元选择</text>
        <picker mode="selector" range="{{textbookUnits}}" range-key="title" bindchange="chooseTextbookUnit">
          <view class="picker-value">{{textbookUnits[selectedUnitIndex].title}}</view>
        </picker>
        <button class="secondary-btn" bindtap="useSelectedUnit">导入这个单元</button>
        <view class="helper">这里先内置常用样例单元，后续可以继续把你的教材版本完整补进去。</view>
      </view>
    </block>

    <block wx:if="{{inputMode === 'mistakes'}}">
      <view class="form-item">
        <text class="label">从错题本导入</text>
        <button class="secondary-btn warm" bindtap="importWrongWords">读取最近错词</button>
        <view class="helper">系统会从孩子答错、不认识的记录里提取词，自动组成一个错词复盘库。</view>
      </view>
    </block>

    <button class="secondary-btn" bindtap="parseText">识别英文词</button>
    <button class="secondary-btn warm" loading="{{translating}}" bindtap="autoGenerateMeanings">自动生成中文</button>
    <button class="primary-btn" bindtap="saveWordList">保存这个词库</button>
    <view wx:if="{{translateProgress}}" class="progress-text">中文生成进度：{{translateProgress}}</view>
  </view>

  <view wx:if="{{parsedWords.length}}" class="card">
    <view class="section-title">预览区：{{parsedWords.length}} / {{maxWords}} 个词/短语</view>
    <view wx:for="{{parsedWords}}" wx:key="word" class="word-row {{item.check ? 'needs-check' : ''}}">
      <view>
        <text class="word">{{item.word}}</text>
        <view wx:if="{{item.check}}" class="check-tip {{item.check.level}}">
          {{item.check.message}}
          <button wx:if="{{item.check.suggestion}}" class="fix-btn" data-index="{{index}}" data-suggestion="{{item.check.suggestion}}" bindtap="applySuggestion">改成 {{item.check.suggestion}}</button>
        </view>
      </view>
      <view class="word-edit-stack">
        <input class="meaning-input" value="{{item.meaning}}" data-index="{{index}}" placeholder="自动生成中文" bindinput="editMeaning" />
        <textarea class="example-input" value="{{item.example}}" data-index="{{index}}" placeholder="教材课文原句 / 语境句，例如：The parrot is looking at itself in the mirror." bindinput="editExample" />
      </view>
    </view>
  </view>

  <view wx:if="{{errors.length}}" class="card">
    <view class="section-title warning">需要检查的内容</view>
    <view wx:for="{{errors}}" wx:key="line" class="error-row">{{item.reason}}</view>
  </view>
</view>
