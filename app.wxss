page {
  min-height: 100vh;
  background: #f7f8fa;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  box-sizing: border-box;
}

view, text, input, textarea, button {
  box-sizing: border-box;
}

.container {
  min-height: 100vh;
  padding: 32rpx;
}

.hero-card,
.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.06);
}

.hero-card {
  background: linear-gradient(135deg, #eef2ff 0%, #ffffff 54%, #ecfeff 100%);
}

.page-title {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.25;
  color: #111827;
  margin-bottom: 16rpx;
}

.page-subtitle {
  font-size: 28rpx;
  line-height: 1.6;
  color: #64748b;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 20rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 12rpx;
}

.input,
.textarea,
.picker-value {
  width: 100%;
  min-height: 88rpx;
  border-radius: 20rpx;
  border: 2rpx solid #e5e7eb;
  background: #ffffff;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: #111827;
}

.textarea {
  min-height: 260rpx;
  line-height: 1.6;
}

.primary-btn,
.secondary-btn,
.ghost-btn {
  width: 100%;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  margin: 20rpx 0 0;
}

.primary-btn {
  background: #4f46e5;
  color: #ffffff;
}

.secondary-btn {
  background: #e0e7ff;
  color: #3730a3;
}

.ghost-btn {
  background: #ffffff;
  color: #4f46e5;
  border: 2rpx solid #c7d2fe;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 26rpx;
}

.tag.active {
  background: #4f46e5;
  color: #ffffff;
}

.grid-two {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.muted {
  color: #64748b;
}

.big-number {
  font-size: 52rpx;
  font-weight: 800;
  color: #4f46e5;
}

.warning {
  color: #f97316;
}

.success {
  color: #16a34a;
}


/* v0.1.14 dark theme */
.theme-dark {
  background: #0f172a;
  color: #e5e7eb;
}
.theme-dark .hero-card,
.theme-dark .card,
.theme-dark .current-panel,
.theme-dark .module-card,
.theme-dark .feature-card,
.theme-dark .stat-box {
  background: #1e293b !important;
  color: #e5e7eb !important;
  border-color: rgba(148, 163, 184, 0.18) !important;
  box-shadow: 0 14rpx 36rpx rgba(0, 0, 0, 0.25) !important;
}
.theme-dark .hero-card {
  background: linear-gradient(135deg, #1e1b4b 0%, #0f172a 55%, #164e63 100%) !important;
}
.theme-dark .page-title,
.theme-dark .section-title,
.theme-dark .word,
.theme-dark .module-title,
.theme-dark .feature-title,
.theme-dark .list-title,
.theme-dark .quiz-meaning {
  color: #f8fafc !important;
}
.theme-dark .page-subtitle,
.theme-dark .muted,
.theme-dark .meaning,
.theme-dark .feature-desc,
.theme-dark .module-desc,
.theme-dark .review-meta,
.theme-dark .quiz-tip {
  color: #cbd5e1 !important;
}
.theme-dark .input,
.theme-dark .textarea,
.theme-dark .picker-value,
.theme-dark .choice-btn,
.theme-dark .spelling-prompt,
.theme-dark .answer-reveal {
  background: #0f172a !important;
  color: #e5e7eb !important;
  border-color: #334155 !important;
}
.theme-dark .ghost-btn {
  background: #0f172a !important;
  color: #a5b4fc !important;
  border-color: #475569 !important;
}
.theme-dark .tag {
  background: #334155 !important;
  color: #cbd5e1 !important;
}
.theme-dark .tag.active {
  background: #6366f1 !important;
  color: #fff !important;
}
.theme-toggle {
  margin-top: 18rpx;
  display: inline-flex;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(79, 70, 229, 0.12);
  color: #4338ca;
  font-size: 24rpx;
  font-weight: 800;
}
.theme-dark .theme-toggle {
  background: rgba(165, 180, 252, 0.16);
  color: #c7d2fe;
}
