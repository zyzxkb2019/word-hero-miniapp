.progress-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.06);
}
.row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  text-align: center;
}
.stat-item {
  border-radius: 18rpx;
  padding: 12rpx 6rpx;
}
.stat-item.clickable {
  background: #f8fafc;
  box-shadow: inset 0 0 0 2rpx rgba(148, 163, 184, 0.14);
}
.stat-item.clickable:active {
  transform: scale(0.97);
  background: #fff7ed;
}
.stat-item.disabled {
  opacity: 0.55;
}
.label {
  color: #64748b;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}
.num {
  color: #4f46e5;
  font-size: 34rpx;
  font-weight: 800;
}
.success { color: #16a34a; }
.warning { color: #f97316; }
.danger { color: #ef4444; }
.mastery-rule {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  color: #64748b;
  font-size: 21rpx;
  line-height: 1.55;
}
.mastery-rule text {
  display: block;
}
